# Copy this file to .env.local and set the value only on your own machine.
# Never commit .env.local or share its contents.
# Production schema-v4 provider chain. Both profiles are required and must be
# OpenAI-compatible Chat Completions providers. Keep .env.local private and ignored.
INFERENCE_MAIN_API_KEY=
INFERENCE_MAIN_BASE_URL=https://openrouter.ai/api/v1
INFERENCE_MAIN_MODEL=deepseek/deepseek-v4-pro-0813

# A distinct provider for the same model, so a main-endpoint outage does not end the
# campaign. The two credentials must be different variables.
INFERENCE_FALLBACK_API_KEY=
INFERENCE_FALLBACK_BASE_URL=https://api.tokenrouter.com/v1
INFERENCE_FALLBACK_MODEL=deepseek/deepseek-v4-pro-0813

# Legacy schema-v2 configurations may still select this variable.
OPENAI_API_KEY=
